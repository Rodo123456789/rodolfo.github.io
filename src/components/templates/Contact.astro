---
const contacto = {
  correo: "rodolfo@example.com",
  telefono: "+52 55 1234 5678",
  linkedin: "https://linkedin.com/in/rodolfocruz",
  github: "https://github.com/rodolfocruz",
};
---

<section id="contacto" class="bg-gray-950 py-20 px-8 text-gray-100">
  <div class="max-w-4xl mx-auto text-center space-y-6">
    <h2 class="text-3xl font-semibold text-blue-400">Contacto</h2>
    <p>Puedes contactarme a través de los siguientes medios:</p>
    <div class="space-y-2">
      <p><strong>Correo:</strong> {contacto.correo}</p>
      <p><strong>Teléfono:</strong> {contacto.telefono}</p>
      <p><strong>LinkedIn:</strong> <a href={contacto.linkedin} class="text-blue-400 hover:underline">{contacto.linkedin}</a></p>
      <p><strong>GitHub:</strong> <a href={contacto.github} class="text-blue-400 hover:underline">{contacto.github}</a></p>
    </div>
  </div>
</section>
