---
const base = import.meta.env.BASE_URL;

const posts = [
  {
    title: "Actividad 1",
    description: "Descripción breve de la actividad uno.",
    image: "/src/assets/blog/uno.jpeg",
    slug: "tarjeta1",
  },
  {
    title: "Actividad 2",
    description: "Descripción breve de la actividad dos.",
    image: "/src/assets/blog/img2.jpg",
    slug: "post-2",
  },
  {
    title: "Actividad 3",
    description: "Descripción breve de la actividad tres.",
    image: "/src/assets/blog/img3.jpg",
    slug: "post-3",
  },
  {
    title: "Actividad 4",
    description: "Descripción breve de la actividad cuatro.",
    image: "/src/assets/blog/img1.jpg",
    slug: "post-4",
  },
  {
    title: "Actividad 5",
    description: "Descripción breve de la actividad cinco.",
    image: "/src/assets/blog/img2.jpg",
    slug: "post-5",
  },
];

const firstRow = posts.slice(0, 3);
const secondRow = posts.slice(3);
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
  </head>

  <body class="bg-gray-950 text-gray-100 min-h-screen">
    <main class="max-w-6xl mx-auto px-6 py-32">

      <h1 class="text-4xl font-bold text-center text-blue-400 mb-16">
        Mi blog personal
      </h1>

      <!-- FILA 1 -->
      <div class="grid md:grid-cols-3 gap-8 mb-8">
        {firstRow.map(post => (
          <a
            href={`${base}blog/${post.slug}/`}
            class="group bg-gray-900 rounded-xl overflow-hidden shadow-lg hover:shadow-blue-500/20 transition"
          >
            <img
              src={post.image}
              alt={post.title}
              class="w-full h-48 object-cover group-hover:scale-105 transition"
            />

            <div class="p-5">
              <h2 class="text-blue-400 font-semibold mb-2">
                {post.title}
              </h2>
              <p class="text-sm text-gray-400">
                {post.description}
              </p>
            </div>
          </a>
        ))}
      </div>

      <!-- FILA 2 (CENTRADA) -->
      <div class="flex justify-center gap-8 flex-wrap">
        {secondRow.map(post => (
          <a
            href={`${base}blog/${post.slug}/`}
            class="group bg-gray-900 rounded-xl overflow-hidden shadow-lg hover:shadow-blue-500/20 transition w-full md:w-[30%]"
          >
            <img
              src={post.image}
              alt={post.title}
              class="w-full h-48 object-cover group-hover:scale-105 transition"
            />

            <div class="p-5">
              <h2 class="text-blue-400 font-semibold mb-2">
                {post.title}
              </h2>
              <p class="text-sm text-gray-400">
                {post.description}
              </p>
            </div>
          </a>
        ))}
      </div>

    </main>
  </body>
</html>
