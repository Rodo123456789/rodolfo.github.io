---
import imagenUno from "/src/assets/blog/uno.jpeg";
import imagenDos from "/src/assets/blog/uno.jpeg";
import imagenTres from "/src/assets/blog/uno.jpeg";
import imagenCuatro from "/src/assets/blog/uno.jpeg";
import imagenCinco from "/src/assets/blog/uno.jpeg";

const posts = [
  {
    title: "Actividad 1",
    description: "Descripción breve de la actividad uno.",
    image: imagenUno,
    slug: "tarjeta1",
  },
  {
    title: "Actividad 2",
    description: "Descripción breve de la actividad dos.",
    image: imagenDos,
    slug: "post-2",
  },
  {
    title: "Actividad 3",
    description: "Descripción breve de la actividad tres.",
    image: imagenTres,
    slug: "post-3",
  },
  {
    title: "Actividad 4",
    description: "Descripción breve de la actividad cuatro.",
    image: imagenCuatro,
    slug: "post-4",
  },
  {
    title: "Actividad 5",
    description: "Descripción breve de la actividad cinco.",
    image: imagenCinco,
    slug: "post-5",
  },
];

const firstRow = posts.slice(0, 3);
const secondRow = posts.slice(3);
---
<main class="bg-gray-950 text-gray-100 min-h-screen">
  <div class="max-w-6xl mx-auto px-6 py-32">

    <h1 class="text-4xl font-bold text-center text-blue-400 mb-16">
      Mi blog personal
    </h1>

    <!-- FILA 1 -->
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      {firstRow.map((post) => (
        <a
  href={`${import.meta.env.BASE_URL}blog/${post.slug}`}
  class="group bg-gray-900 rounded-xl overflow-hidden shadow-lg hover:shadow-blue-500/20 transition"
>

          <img
            src={post.image.src}
            alt={post.title}
            class="w-full h-48 object-cover group-hover:scale-105 transition"
          />

          <div class="p-5">
            <h2 class="text-blue-400 font-semibold mb-2">
              {post.title}
            </h2>
            <p class="text-sm text-gray-400">
              {post.description}
            </p>
          </div>
        </a>
      ))}
    </div>

    <!-- FILA 2 -->
    <div class="flex justify-center gap-8 flex-wrap">
      {secondRow.map((post) => (
        <a
  href={`${import.meta.env.BASE_URL}blog/${post.slug}`}
  class="group bg-gray-900 rounded-xl overflow-hidden shadow-lg hover:shadow-blue-500/20 transition"
>

          <img
            src={post.image.src}
            alt={post.title}
            class="w-full h-48 object-cover group-hover:scale-105 transition"
          />

          <div class="p-5">
            <h2 class="text-blue-400 font-semibold mb-2">
              {post.title}
            </h2>
            <p class="text-sm text-gray-400">
              {post.description}
            </p>
          </div>
        </a>
      ))}
    </div>

  </div>
</main>
