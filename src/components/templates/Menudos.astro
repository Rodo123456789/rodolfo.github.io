---
const withBase = (path = "") =>
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;

const currentPath = Astro.url.pathname.replace(/\/$/, "");


const isActive = (path = "") => {
  const target = withBase(path).replace(/\/$/, "");
  return currentPath === target;
};
---

<nav class="fixed top-0 left-0 w-full bg-gray-900/90 backdrop-blur-sm text-white shadow-md z-50">
  <div class="max-w-7xl mx-auto px-6 py-10 flex justify-between items-center">
    <h1 class="text-3xl font-semibold tracking-wide">Mi Blog</h1>

    <ul class="flex space-x-8 text-sm font-medium">
      <!-- BLOG -->
      <li class="relative">
        <a
          href={withBase()}
          class={`pb-2 text-xl font-semiboldtransition ${
            isActive() ? "text-blue-400" : "hover:text-blue-400"
          }`}
        >
          REGRESAR
        </a>

        {isActive() && (
          <span class="absolute left-0 -bottom-1 w-full h-0.5 bg-blue-400 rounded-full"></span>
        )}
      </li>

    </ul>
  </div>
</nav>
