---
const withBase = (path = "") => {
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  const cleanPath = path.replace(/^\//, "").replace(/\/$/, "");
  return `${base}/${cleanPath}/`;
};

const currentPath = Astro.url.pathname.replace(/\/$/, "");

const isActive = (path = "") => {
  const target = withBase(path).replace(/\/$/, "");
  return currentPath === target;
};
---

<nav class="fixed top-0 left-0 w-full bg-gray-900/90 backdrop-blur-sm text-white shadow-md z-50">
  <div class="max-w-7xl mx-auto px-6 py-10 flex justify-between items-center">
    <h1 class="text-3xl font-semibold tracking-wide">Mi Portafolio</h1>

    <button
      id="menu-btn"
      class="md:hidden focus:outline-none"
      aria-label="Abrir menú"
    >
      <svg
        class="w-7 h-7"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"
        />
      </svg>
    </button>

    <ul class="hidden md:flex space-x-8 text-sm font-medium">
      {[
        ["", "Mi blog"],
        ["sobremi", "Sobre mí"],
        ["cualidades", "Cualidades"],
        ["galeria", "Contenido visual"],
        ["proyectos", "Proyectos"],
        ["formulario", "Formulario"],
      ].map(([path, label]) => (
        <li class="relative">
          <a
            href={withBase(path)}
            class={`pb-2 transition ${
              isActive(path) ? "text-blue-400" : "hover:text-blue-400"
            }`}
          >
            {label}
          </a>

          {isActive(path) && (
            <span class="absolute left-0 -bottom-1 w-full h-0.5 bg-blue-400 rounded-full"></span>
          )}
        </li>
      ))}
    </ul>
  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden bg-gray-900 border-t border-gray-800"
  >
    <ul class="flex flex-col px-6 py-4 space-y-4 text-sm">
      {[
        ["", "Mi blog"],
        ["sobremi", "Sobre mí"],
        ["cualidades", "Cualidades"],
        ["galeria", "Contenido visual"],
        ["proyectos", "Proyectos"],
        ["formulario", "Formulario"],
      ].map(([path, label]) => (
        <li>
          <a
            href={withBase(path)}
            class={`block ${
              isActive(path)
                ? "text-blue-400 font-semibold"
                : "hover:text-blue-400"
            }`}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
</script>
