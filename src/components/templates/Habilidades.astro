---
const habilidades = [
  { texto: "Responsable", img: "/info/res.png" },
  { texto: "Creativo", img: "/info/creativo.png" },
  { texto: "Conocimientos técnicos en Sistemas y Administración", img: "/info/sistemas.png" },
  { texto: "Trabajo en equipo y comunicación", img: "/info/equipo.png" },
  { texto: "Aprendizaje continuo", img: "/info/continuo.png" },
];

const gustos = [
  { texto: "Música regional Mexicano", img: "/info/musica.png" },
  { texto: "Café", img: "/info/cafe.png" },
  { texto: "Videojuegos", img: "/info/videojuegos.png" },
  { texto: "Tecnología e innovación", img: "/info/tecnologia.webp" },
  { texto: "Naturaleza y fotografía", img: "/info/naturaleza.png" },
];
---

<section id="habilidades" class="bg-gray-900 py-20 px-8 text-gray-100">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl font-semibold text-center text-blue-400 mb-10">
      Cualidades y gustos
    </h2>

    <div class="grid md:grid-cols-2 gap-10">
      <div>
        <h3 class="text-2xl mb-4 text-gray-200">Cualidades</h3>
        
        <ul class="space-y-4">
          {habilidades.map((item) => (
            <li class="relative overflow-hidden rounded-lg shadow-sm bg-gray-800 hover:bg-gray-700 transition p-4 flex items-center">


              <img 
                src={item.img}
                alt=""
                class="absolute inset-0 w-full h-full object-cover opacity-30 blur-sm"
              />

              <div class="w-11 h-11 rounded-full overflow-hidden border-2 border-gray-300 mr-4 z-10">
                <img src={item.img} alt="" class="w-full h-full object-cover" />
              </div>

        
              <span class="z-10 relative font-medium">
                {item.texto}
              </span>

            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-2xl mb-4 text-gray-200">Gustos</h3>
        
        <ul class="space-y-4">
          {gustos.map((item) => (
            <li class="relative overflow-hidden rounded-lg shadow-sm bg-gray-800 hover:bg-gray-700 transition p-4 flex items-center">

              <img 
                src={item.img}
                alt=""
                class="absolute inset-0 w-full h-full object-cover opacity-30 blur-sm"
              />

              <div class="w-11 h-11 rounded-full overflow-hidden border-2 border-gray-300 mr-4 z-10">
                <img src={item.img} alt="" class="w-full h-full object-cover" />
              </div>

        
              <span class="z-10 relative font-medium">
                {item.texto}
              </span>

            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>
