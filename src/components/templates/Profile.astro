---
const profile = {
  name: "Rodolfo Cruz Ibarra",
  title: "Estudiante",
  age: 21,
  location: "México",
  description:
    "Soy Rodolfo Cruz Ibarra",
};
---

<section id="inicio" class="flex flex-col md:flex-row items-center justify-center gap-8 min-h-screen pt-20 px-8 bg-gray-950 text-gray-100">
  <div class="flex flex-col items-center md:items-start space-y-4 md:w-1/3">
    <img
      src="/src/assets/profile.jpg"
      alt="Foto de perfil"
      class="w-48 h-48 object-cover rounded-full border-4 border-blue-400 shadow-lg"
    />
    <div class="bg-gray-800 rounded-2xl p-5 w-full">
      <h2 class="text-2xl font-semibold">{profile.name}</h2>
      <p class="text-blue-400">{profile.title}</p>
      <p class="text-sm mt-2">Edad: {profile.age}</p>
      <p class="text-sm">Ubicación: {profile.location}</p>
    </div>
  </div>

  <div class="md:w-2/3 text-center md:text-left space-y-6">
    <h3 class="text-3xl font-semibold text-blue-400">Sobre mí</h3>
    <p class="leading-relaxed text-gray-300">
      {profile.description}
    </p>
  </div>
</section>
