---
import "../styles/global.css";
import Navbar from "../components/templates/Menu.astro";

const imagenes = [
  "/galeria/1.jpg",
  "/galeria/2.jpg",
  "/galeria/3.jpg",
  "/galeria/4.jpg",
  "/galeria/5.jpg",
  "/galeria/6.jpg",
  "/galeria/7.jpg",
  "/galeria/8.jpg",
  "/galeria/img9.jpg",
  "/galeria/img10.jpg",
  "/galeria/img11.jpg",
  "/galeria/img12.jpg",
  "/galeria/img13.jpg",
  "/galeria/img14.jpg",
  "/galeria/img15.jpg",
  "/galeria/img16.jpg",
  "/galeria/img1.jpg",
  "/galeria/img2.jpg",
  "/galeria/img3.jpg",
  "/galeria/img4.jpg",
  "/galeria/img5.jpg",
  "/galeria/img6.jpg",
  "/galeria/img7.jpg",
  "/galeria/img8.jpg",
  "/galeria/9.jpg",
  "/galeria/10.jpg",
  "/galeria/11.jpg",
  "/galeria/12.jpg",
  "/galeria/13.jpg",
  "/galeria/14.jpg",
  "/galeria/15.jpg",
  "/galeria/16.jpg",
];
---

<div class="bg-gray-950 text-gray-100 font-sans min-h-screen">

  <Navbar />
  <main class="pt-32 px-6">

    <h1 class="text-center text-4xl font-bold text-blue-400 mb-10">
      Contenido visual personal
    </h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">

      {imagenes.map((img) => (
        <div class="overflow-hidden rounded-xl shadow-lg group">
          
          <img 
            src={img} 
            alt="Imagen" 
            class="w-full h-50  object-cover transition-transform duration-500 group-hover:scale-120 group-hover:brightness-113"
          />
        </div>
      ))}

    </div>

  </main>

</div>

<footer class="bg-gray-900 py-6 text-center text-gray-500 text-sm">
  © {new Date().getFullYear()} Rodolfo Cruz Ibarra - Todos los derechos reservados.
</footer>