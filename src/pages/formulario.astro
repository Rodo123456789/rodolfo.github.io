---
import "../styles/global.css";

import Navbar from "../components/templates/Menu.astro";
import Footer from "../components/templates/Pie.astro";
import Form from "../pages/contact/index.astro"


import facebook from "/src/assets/iconos/facebook.webp";
import whatsapp from "/src/assets/iconos/whatsapp.webp";
import tiktok from "/src/assets/iconos/ticktok.jpeg";
import youtube from "/src/assets/iconos/youtube.png";
import ubicacion from "/src/assets/iconos/ubicacion.webp";
import gmail from "/src/assets/iconos/gmail.webp";
import telefono from "/src/assets/iconos/telefono.webp";
import github from "/src/assets/iconos/github.webp";

const contacto = {
  ubicacion: "Tres Estrellas, San Felipe del Progreso, México",
  correo: "rodolfocruzibarra@gmail.com",
  telefono: "56-15-26-34-26",
  github: "https://github.com/Rodo123456789",
};

const redes = [
  {
    nombre: "Facebook",
    url: "https://www.facebook.com/share/1A5WZCHwze/",
    img: facebook.src,
  },
  {
    nombre: "WhatsApp",
    url: "https://wa.me/5215615263426",
    img: whatsapp.src,
  },
  {
    nombre: "TikTok",
    url: "https://www.tiktok.com/@rodo_tv?_r=1&_t=ZS-91QZTuW8gKK",
    img: tiktok.src,
  },
  {
    nombre: "YouTube",
    url: "https://www.youtube.com/@RodolfoCruzIbarra",
    img: youtube.src,
  },
];


const icons = {
  ubicacion: ubicacion.src,
  correo: gmail.src,
  telefono: telefono.src,
  github: github.src,
};
---
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Formulario de contacto</title>
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/2920/2920277.png" />
  </head>

<body class="bg-gray-950 font-sans">
   
    <Navbar />

    <main>
<br><br><br><br>

      <section id="formulario">
        <Form />
      </section>

    </main>

<section id="contacto" class="bg-gray-950 py-5 px-8 text-gray-100">
 <div class="max-w-6xl mx-auto">
  <br>
  
  <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-50">

    <div class="text-left space-y-6">
      <h4 class="text-2xl font-semibold text-gray-500">Úbicación</h4>

      <ul class="space-y-4">

        <li class="flex items-center space-x-4">
          <img src={icons.ubicacion} class="w-12 h-12 rounded-full object-cover border-2 border-gray-700" alt="ubicacion" />
          <span class="text-lg">{contacto.ubicacion}</span>
        </li>

        <li class="flex items-center space-x-4">
          <img src={icons.correo} class="w-12 h-12 rounded-full object-cover border-2 border-gray-700" alt="correo" />
          <a 
            href={`https://mail.google.com/mail/?view=cm&fs=1&to=${contacto.correo}`} 
            target="_blank" 
            class="text-lg hover:text-blue-400"
          >
            {contacto.correo}
          </a>
        </li>

        <li class="flex items-center space-x-4">
          <img src={icons.telefono} class="w-12 h-12 rounded-full object-cover border-2 border-gray-700" alt="teléfono" />
          <span class="text-lg">{contacto.telefono}</span>
        </li>

        <li class="flex items-center space-x-4">
          <img src={icons.github} class="w-12 h-12 rounded-full object-cover border-2 border-gray-700" alt="github" />
          <a 
            href={contacto.github} 
            target="_blank" 
            class="text-lg hover:text-blue-400"
          >
            GitHub
          </a>
        </li>

      </ul>
    </div>

    <div class="text-left">
      <h4 class="text-2xl font-semibold text-gray-500 mb-4">Redes Sociales</h4>

      <ul class="space-y-4">
        {redes.map((r) => (
          <li class="flex items-center space-x-4">
            <img src={r.img} alt={r.nombre} class="w-12 h-12 rounded-full object-cover border-2 border-gray-700"/>
            <a href={r.url} target="_blank" class="text-lg hover:text-blue-400">
              {r.nombre}
            </a>
          </li>
        ))}
      </ul>
    </div>

  </div>
</div>

</section>


   <footer class="bg-gray-950 py-9 text-center text-gray-100 text-sm">

</footer>
    <Footer />
  </body>