---
import "../styles/global.css";

import Navbar from "../components/templates/Menu.astro";
import Footer from "../components/templates/Pie.astro";


import responsable from "/src/assets/info/res.png";
import creativo from "/src/assets/info/creativo.png";
import conocimiento from "/src/assets/info/sistemas.png";
import trabajo from "/src/assets/info/equipo.png";
import aprendizaje from "/src/assets/info/continuo.png";
import musica from "/src/assets/info/musica.png";
import cafe from "/src/assets/info/cafe.png";
import videojuegos from "/src/assets/info/videojuegos.png";
import tecnologia from "/src/assets/info/tecnologia.webp";
import naturaleza from "/src/assets/info/naturaleza.png";

const habilidades = [
  { texto: "Responsable", img: responsable.src },
  { texto: "Creativo", img: creativo.src },
  { texto: "Conocimientos técnicos en Sistemas y Administración", img: conocimiento.src },
  { texto: "Trabajo en equipo y comunicación", img: trabajo.src },
  { texto: "Aprendizaje continuo", img: aprendizaje.src },
];

const gustos = [
  { texto: "Música regional Mexicana", img: musica.src },
  { texto: "Café", img: cafe.src },
  { texto: "Videojuegos", img: videojuegos.src },
  { texto: "Tecnología e innovación", img: tecnologia.src },
  { texto: "Naturaleza y fotografía", img: naturaleza.src },
];
---


  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cualidades y gustos</title>
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/2920/2920277.png" />
  </head>

  <body class="bg-gray-950 font-sans text-gray-100 min-h-screen">
      <Navbar />

    <section id="habilidades" class="py-20 px-8">
      <div class="max-w-7xl mx-auto">
<br><br>
        <h2 class="text-4xl font-semibold text-center text-blue-400 mb-14">
          Cualidades y gustos
        </h2>

        <div class="grid md:grid-cols-2 gap-10">

          <!-- CUALIDADES -->
          <div>
            <h3 class= " text-center text-2xl mb-6 text-gray-200">Cualidades</h3>

            <ul class="space-y-4">
              {habilidades.map((item) => (
                <li class="relative overflow-hidden rounded-lg shadow-md bg-gray-800/80 hover:bg-gray-700 transition p-4 flex items-center">

                  <img
                    src={item.img}
                    alt=""
                    class="absolute inset-0 w-full h-full object-cover opacity-30 blur-sm"
                  />

                  <div class="w-11 h-11 rounded-full overflow-hidden border-2 border-gray-300 mr-4 z-10">
                    <img src={item.img} alt="" class="w-full h-full object-cover" />
                  </div>

                  <span class="z-10 relative font-medium">
                    {item.texto}
                  </span>

                </li>
              ))}
            </ul>
          </div>

          <!-- GUSTOS -->
          <div>
            <h3 class=" text-center text-2xl mb-6 text-gray-200">Gustos</h3>

            <ul class="space-y-4">
              {gustos.map((item) => (
                <li class="relative overflow-hidden rounded-lg shadow-md bg-gray-800/80 hover:bg-gray-700 transition p-4 flex items-center">

                  <img
                    src={item.img}
                    alt=""
                    class="absolute inset-0 w-full h-full object-cover opacity-30 blur-sm"
                  />

                  <div class="w-11 h-11 rounded-full overflow-hidden border-2 border-gray-300 mr-4 z-10">
                    <img src={item.img} alt="" class="w-full h-full object-cover" />
                  </div>

                  <span class="z-10 relative font-medium">
                    {item.texto}
                  </span>

                </li>
              ))}
            </ul>
          </div>

        </div>
      </div>
    </section>
    <Footer />

  </body>

