---
import "../styles/global.css";

import Navbar from "../components/templates/Menu.astro";
import ProfileCard from "../components/templates/Info.astro";
import SkillsSection from "../pages/cualidades.astro";
import Proyectos from "../components/templates/Proyectos.astro";
import Galeria from "../components/templates/Galeria.astro";
import ContactSection from "../components/templates/Contacto.astro";
import Footer from "../components/templates/Pie.astro";
import Form from "../pages/contact/index.astro"
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portafolio - Rodolfo Cruz Ibarra</title>

    
    <style>
      html {
        scroll-behavior: smooth;
      }
    </style>
  </head>

  <body class="bg-gray-950 font-sans">
   
    <Navbar />

    <main>

     
      <section id="inicio">
        <ProfileCard />
      </section>

      
      <section id="cualidades">
        <SkillsSection />
      </section>

   
      <section id="proyectos">
        <Proyectos />
      </section>

    
      <section id="galeria">
        <Galeria />
      </section>

     
      <section id="contacto">
        <ContactSection />
      </section>

      <section id="formulario">
        <Form />
      </section>

    </main>

   
    <Footer />
  </body>
</html>
