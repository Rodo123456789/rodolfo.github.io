---
import "../styles/global.css";

import Navbar from "../components/templates/Menu.astro";
import Footer from "../components/templates/Pie.astro";

import imagenUno from "/src/assets/blog/uuno.jpeg";
import imagenDos from "/src/assets/blog/2.jpeg";
import imagenTres from "/src/assets/blog/3.1.jpg";
import imagenCuatro from "/src/assets/blog/4.1.webp";
import imagenCinco from "/src/assets/blog/cinco.jpeg";

/* === FUNCIÓN SEGURA PARA GITHUB PAGES === */
const withBase = (path = "") => {
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  const cleanPath = path.replace(/^\//, "").replace(/\/$/, "");
  return `${base}/${cleanPath}/`;
};

const posts = [
  {
    title: "Mi vida diaria",
    description: "Descripción de mis actividades rutinarias.",
    image: imagenUno,
    slug: "tarjeta1",
  },
  {
    title: "Asistencia a eventos musicales",
    description:
      "Asistir a eventos masivos donde se presentan mis grupos favoritos",
    image: imagenDos,
    slug: "tarjeta2",
  },
  {
    title: "Visita al museo del Banco de México",
    description:
      "Visité el museo del Banco de México para aprender sobre la historia monetaria.",
    image: imagenTres,
    slug: "tarjeta3",
  },
  {
    title: "Mi PS5 y mis videojuegos favoritos",
    description: "Descripción de mis videojuegos favoritos en mi tiempo libre.",
    image: imagenCuatro,
    slug: "tarjeta4",
  },
  {
    title: "Mis películas favoritas",
    description:
      "Mis mejores películas que he visto y se han convertido en mis favoritas",
    image: imagenCinco,
    slug: "tarjeta5",
  },
];

const firstRow = posts.slice(0, 3);
const secondRow = posts.slice(3);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog</title>
    <link
      rel="icon"
      href="https://cdn-icons-png.flaticon.com/512/2920/2920277.png"
    />
  </head>

  <body>
    <Navbar />

    <main class="bg-gray-950 text-gray-100 min-h-screen">
      <div class="max-w-8xl mx-auto px-6 py-32">
        <h1 class="text-4xl font-bold text-center text-blue-400 mb-16">
          Mi blog personal
        </h1>

        <!-- FILA 1 -->
        <div id="page-1" class="grid md:grid-cols-3 gap-8 mb-8">
          {
            firstRow.map((post) => (
              <a
                href={withBase(`blog/${post.slug}`)}
                class="group bg-gray-900 rounded-xl overflow-hidden shadow-lg hover:shadow-blue-500/20 transition"
              >
                <img
                  src={post.image.src}
                  alt={post.title}
                  class="w-full h-64 object-cover group-hover:scale-105 transition"
                />

                <div class="p-5">
                  <h2 class="text-blue-400 font-semibold mb-2">
                    {post.title}
                  </h2>
                  <p class="text-sm text-gray-400">
                    {post.description}
                  </p>
                </div>
              </a>
            ))
          }
        </div>

        <!-- FILA 2 (MISMO GRID QUE FILA 1) -->
        <div
  id="page-2"
  class:list={["grid", "md:grid-cols-3", "gap-8", "mb-8", "hidden"]}
>

          {
            secondRow.map((post) => (
              <a
                href={withBase(`blog/${post.slug}`)}
                class="group bg-gray-900 rounded-xl overflow-hidden shadow-lg hover:shadow-blue-500/20 transition"
              >
                <img
                  src={post.image.src}
                  alt={post.title}
                  class="w-full h-64 object-cover group-hover:scale-105 transition"
                />

                <div class="p-5">
                  <h2 class="text-blue-400 font-semibold mb-2">
                    {post.title}
                  </h2>
                  <p class="text-sm text-gray-400">
                    {post.description}
                  </p>
                </div>
              </a>
            ))
          }
        </div>

        <!-- PAGINACIÓN -->
        <div class="flex justify-center gap-4 mt-10">
          <button
            id="btn-1"
            class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600"
          >
            1
          </button>

          <button
            id="btn-2"
            class="px-4 py-2 bg-gray-700 text-white rounded hover:bg-blue-600"
          >
            2
          </button>
        </div>
      </div>
    </main>

    <Footer />

    <script>
      const page1 = document.getElementById("page-1");
      const page2 = document.getElementById("page-2");
      const btn1 = document.getElementById("btn-1");
      const btn2 = document.getElementById("btn-2");

      btn1?.addEventListener("click", () => {
        page1?.classList.remove("hidden");
        page2?.classList.add("hidden");

        btn1.classList.add("bg-blue-500");
        btn2?.classList.remove("bg-blue-500");
        btn2?.classList.add("bg-gray-700");
      });

      btn2?.addEventListener("click", () => {
        page1?.classList.add("hidden");
        page2?.classList.remove("hidden");

        btn2.classList.add("bg-blue-500");
        btn1?.classList.remove("bg-blue-500");
        btn1?.classList.add("bg-gray-700");
      });
    </script>
  </body>
</html>
