---
import "../styles/global.css";

import Navbar from "../components/templates/Menu.astro";
import ProfileCard from "../components/templates/Info.astro";
import SkillsSection from "../components/templates/Habilidades.astro";
import Proyectos from "../components/templates/Proyectos.astro";
import Galeria from "../components/templates/Galeria.astro";
import ContactSection from "../components/templates/Contacto.astro";
import Footer from "../components/templates/Pie.astro";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portafolio - Rodolfo Cruz Ibarra</title>

    <!-- Scroll suave (opcional pero recomendado) -->
    <style>
      html {
        scroll-behavior: smooth;
      }
    </style>
  </head>

  <body class="bg-gray-950 font-sans">
    <!-- NAVBAR -->
    <Navbar />

    <main>

      <!-- Sección de Inicio -->
      <section id="inicio">
        <ProfileCard />
      </section>

      <!-- Sección de Habilidades -->
      <section id="habilidades">
        <SkillsSection />
      </section>

      <!-- Sección de Proyectos -->
      <section id="proyectos">
        <Proyectos />
      </section>

      <!-- Sección de Galería -->
      <section id="galeria">
        <Galeria />
      </section>

      <!-- Sección de Contacto -->
      <section id="contacto">
        <ContactSection />
      </section>

    </main>

    <!-- FOOTER -->
    <Footer />
  </body>
</html>
