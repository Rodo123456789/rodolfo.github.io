---
import "../styles/global.css";
import Navbar from "../components/templates/Menu.astro";

Astro.response.headers.set("Content-Type", "text/html; charset=utf-8");

const descripcion1 = `
  <p>
    El proyecto consiste en una recreación fiel del clásico juego 
    Space Invaders, desarrollado completamente en Godot Engine.
  </p>
  <p>
    El objetivo principal fue replicar la mecánica original del juego,
    manteniendo la experiencia nostálgica, pero añadiendo algunas mejoras modernas
    para optimizar la jugabilidad y la interacción del jugador.
  </p>
  <p>
    Se incluye el enlace al repositorio y un video demostrativo.
  </p>
`;

const descripcion2 = `
  <p>
    El proyecto es un juego de arcade en 2D desarrollado en Pygame, 
    donde el jugador controla un cuadrado rojo que debe recoger alimentos 
    mientras evita colisionar con otros cuatro cuadrados enemigos.
  </p>
  <p>
  El jugador es un cuadrado rojo que se mueve libremente por la pantalla con 
  las teclas de dirección. Su comida aparece en posiciones aleatorias; al ser 
  consumida, incrementa el puntaje y reaparece en otro lugar. Sus enemigos son 
  tres cuadrados se mueven verticalmente de manera predecible y uno se mueve 
  aleatoriamente cada cierto tiempo, aumentando la dificultad. 
  </p>
  
`;

const descripcion3 = `
  <p>
  El proyecto consiste en un juego de máquina de monedas, donde el jugador debe 
  acercarse con una cierta cantidad de monedas para poder jugar. Al insertar una moneda, 
  el jugador elige un número del 1 al 3 y la máquina genera un resultado según probabilidades 
  predeterminadas: 0 tiene mayor probabilidad de salir, mientras que los números elegidos tienen 
  recompensas variables según su probabilidad.
  </p>
  <p>
  Si el número del jugador coincide con el resultado, recibe monedas de recompensa; de lo contrario, 
  no gana nada. El juego combina azar y estrategia para gestionar las recompensas.
  </p>
`;

const descripcion4 = `
  <p>
  El proyecto consiste en una simulación de operaciones de un aeropuerto con tres aviones que 
  tienen destinos y capacidades diferentes: Canadá (10 pasajeros), Brasil (15 pasajeros) y Rusia 
  (20 pasajeros). Cada avión aparece en la simulación según un tiempo de aparición predeterminado, 
  y los pasajeros se forman en fila para abordar, con tiempos de espera aleatorios por persona.
  </p>
  <p>
  Una vez que se llena la capacidad del avión, éste despega y da paso al siguiente. La simulación 
  lleva un contador de pasajeros totales y registra las ganancias del aeropuerto, considerando una 
  comisión de 5 unidades por pasajero.
  </p>
`;

const proyectos = [
  {
    nombre: "1: Juego Space-Invaders en Godot",
    descripcion: descripcion1,
    link: "https://github.com/Rodo123456789/Juego-de-Space-Invaders",
    video: "/src/assets/videos/video1.mp4"
  },
  {
    nombre: "2: Juego Atrapa y Escapa en Pygame",
    descripcion: descripcion2,
    link: "https://github.com/Rodo123456789/Juego-de-Atrapa-y-Escapa",
    video: "/src/assets/videos/video2.mp4"
  },
  {
    nombre: "3: Simulación de una máquina de monedas",
    descripcion: descripcion3,
    link: "https://github.com/Rodo123456789/Maqina-de-monedas",
    video: "/src/assets/videos/video3.mp4"
  },
  {
    nombre: "4: Simulación de operaciones de un aeropuerto",
    descripcion: descripcion4,
    link: "https://github.com/Rodo123456789/Simulacion-de-un-aeropuerto",
    video: "/src/assets/videos/video4.mp4"
  },
];
---

<div class="bg-gray-950 text-gray-100 min-h-screen font-sans">

  <Navbar />

  <main class="pt-32 px-6 max-w-6xl mx-auto">

    <h1 class="text-center text-4xl font-bold text-blue-400 mb-5">
      Portafolio de proyectos
    </h1>
    

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">

      {proyectos.map((p) => (
        <div class="bg-gray-900 p-7 rounded-2xl shadow-lg border border-gray-700">

          <h2 class="text-2xl font-semibold text-blue-300">{p.nombre}</h2>

          <div
            class="text-gray-300 mt-3 text-sm text-justify leading-relaxed space-y-4"
            set:html={p.descripcion}
          ></div>
          
          <p class="mt-3 text-sm">
            <strong class="text-blue-400">Link:</strong>  
            <a href={p.link} class="text-blue-300 hover:underline" target="_blank">
              {p.link}
            </a>
          </p>

          <div class="mt-4">
            <video 
              src={p.video}
              controls
              class="w-full h-52 rounded-lg border border-gray-600"
            ></video>
          </div>

        </div>
      ))}

    </div>

  </main>



<footer class="bg-gray-900 py-6 text-center text-gray-500 text-sm mt-10">
  © {new Date().getFullYear()} Rodolfo Cruz Ibarra - Todos los derechos reservados.
</footer>
</div>
