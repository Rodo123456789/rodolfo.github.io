---
import { getCollection } from "astro:content";
import "/src/styles/global.css";
import Navbar from "../../components/templates/Menudos.astro";
import Footer from "../../components/templates/Pie.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { id: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const title = post.data.title;
const images = post.data.images ?? [];
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
</head>

<Navbar />

<style>
  .carousel {
    display: flex;
    overflow: hidden;
  }

  .carousel img {
    min-width: 100%;
    height: 20rem;
    object-fit: cover;
  }
</style>

<main class="bg-gray-950 text-gray-100 min-h-screen">
  <div class="max-w-6xl mx-auto px-6 py-32">

    <h1 class="text-4xl font-bold text-center text-blue-400 mb-16">
      {title}
    </h1>

    <div class="grid md:grid-cols-2 gap-10">

      <!-- IMÁGENES -->
      {images.length > 0 && (
        <div class="carousel rounded-xl overflow-hidden">
          {images.map((img) => (
            <img
              src={`${import.meta.env.BASE_URL}${img.replace(/^\//, "")}`}
              alt={title}
            />
          ))}
        </div>
      )}

      <!-- CONTENIDO MD -->
      <div class="bg-gray-900 rounded-xl p-6 text-gray-300 leading-relaxed">
        <Content />
      </div>

    </div>
  </div>
</main>

<Footer />
