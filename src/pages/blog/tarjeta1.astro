---
import "/src/styles/global.css";

// 🔹 IMÁGENES IMPORTADAS
import img1 from "/src/assets/blog/uno.jpeg";
import img2 from "/src/assets/blog/uno.jpeg";
import img3 from "/src/assets/blog/uno.jpeg";

const title = "Actividad 1";
const description = `
Esta es la descripción completa de la actividad.
Aquí puedes explicar con más detalle de qué trata,
qué aprendiste o qué desarrollaste.
`;

const images = [img1, img2, img3];
---

<title>{title}</title>

<style>
  .carousel {
    display: flex;
    overflow: hidden;
    scroll-behavior: smooth;
  }

  .carousel img {
    min-width: 100%;
    height: 20rem;
    object-fit: cover;
    flex-shrink: 0;
  }
</style>

<main class="bg-gray-950 text-gray-100 min-h-screen">
  <div class="max-w-6xl mx-auto px-6 py-20">

    <!-- TÍTULO -->
    <h1 class="text-4xl font-bold text-center text-blue-400 mb-16">
      {title}
    </h1>

    <!-- CONTENIDO -->
    <div class="grid md:grid-cols-2 gap-10">

      <!-- CARRUSEL -->
      <div
        class="carousel rounded-xl overflow-hidden"
        id="carousel"
      >
        {images.map((img) => (
          <img src={img.src} alt="Imagen del proyecto" />
        ))}

        <!-- CLON DE LA PRIMERA IMAGEN -->
        <img src={images[0].src} alt="Imagen clonada" />
      </div>

      <!-- DESCRIPCIÓN -->
      <div class="bg-gray-900 rounded-xl p-6 leading-relaxed text-gray-300">
        <p>{description}</p>
      </div>

    </div>

  </div>
</main>

<script>
  const carousel = document.getElementById("carousel");

  if (carousel) {
    const slides = carousel.children;
    let index = 0;

    setInterval(() => {
      index++;

      carousel.scrollTo({
        left: carousel.clientWidth * index,
        behavior: "smooth",
      });

      // cuando llega al clon
      if (index === slides.length - 1) {
        setTimeout(() => {
          carousel.style.scrollBehavior = "auto";
          carousel.scrollLeft = 0;
          index = 0;
          carousel.style.scrollBehavior = "smooth";
        }, 600);
      }
    }, 4000);
  }
</script>
