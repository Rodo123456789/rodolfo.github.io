---
import "/src/styles/global.css";

import Navbar from "../../components/templates/Menudos.astro";
import Footer from "../../components/templates/Pie.astro";

import img1 from "/src/assets/blog/2.jpeg";
import img2 from "/src/assets/blog/2.2.jpeg";
import img3 from "/src/assets/blog/2.3.jpeg";

const title = "Asistencia a eventos musicales";
const description = `
Uno de mis pasatiempos favoritos es asistir a conciertos y festivales de música en vivo de grupos que son de mi agrado.

Cuando acudo a uno de estos eventos hay varias cosas que realizo, por ejemplo es poder salir un rato con mis amigos, el poder
visiatar otras comunidades. Lo más importantes poder conocer estos grupos musicales en vivo y poder didfrutar cada una
de las canciones que interpretan.

Igual es poder capturar esos momentos en video, para posterior subrlo a diferentes redes sociales como YouTube.`;

const images = [img1, img2, img3];
---

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Asistencia a eventos musicales</title>
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/2920/2920277.png" />
  </head>

<Navbar />
<title>{title}</title>
<style>
  .carousel {
    display: flex;
    overflow: hidden;
    scroll-behavior: smooth;
  }

  .carousel img {
    min-width: 100%;
    height: 20rem;
    object-fit: cover;
    flex-shrink: 0;
  }
</style>

<main class="bg-gray-950 text-gray-100 min-h-screen">
  <div class="max-w-6xl mx-auto px-6 py-32">

    <h1 class="text-4xl font-bold text-center text-blue-400 mb-16">
      {title}
    </h1>

    <div class="grid md:grid-cols-2 gap-10">

      <div
        class="carousel rounded-xl overflow-hidden"
        id="carousel"
      >
        {images.map((img) => (
          <img src={img.src} alt="Imagen del proyecto" />
        ))}

        <img src={images[0].src} alt="Imagen clonada" />
      </div>

      
      <div class="bg-gray-900 rounded-xl p-6 leading-relaxed text-gray-300 space-y-4 text-justify">
  {description
    .trim()
    .split("\n\n")
    .map((text) => (
      <p>{text}</p>
    ))}
</div>

    </div>

  </div>
</main>

<script>
  const carousel = document.getElementById("carousel");

  if (carousel) {
    const slides = carousel.children;
    let index = 0;

    setInterval(() => {
      index++;

      carousel.scrollTo({
        left: carousel.clientWidth * index,
        behavior: "smooth",
      });

      if (index === slides.length - 1) {
        setTimeout(() => {
          carousel.style.scrollBehavior = "auto";
          carousel.scrollLeft = 0;
          index = 0;
          carousel.style.scrollBehavior = "smooth";
        }, 600);
      }
    }, 4000);
  }
</script>
<Footer />