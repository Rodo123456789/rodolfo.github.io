---
import "/src/styles/global.css";

import Navbar from "../../components/templates/Menudos.astro";
import Footer from "../../components/templates/Pie.astro";

import img1 from "/src/assets/blog/3.1.jpg";
import img2 from "/src/assets/blog/oro.jpeg";
import img3 from "/src/assets/blog/bille.jpeg";

const title = "Visita al museo del Banco de México";
const description = `
El día 11 de noviembre de 2025 acudí al museo del Banco de México, ubicado en la Ciudad de Mexico. 
Este museo es conocido por su amplia colección de artefactos relacionados con la historia monetaria y económica de Mécico.

Fue una experiencia muy agradable el poder salir de la rutina diaria y visitar un lugar cultural e histórico. `;

const images = [img1, img2, img3];
---

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Visita al museo del Banco de México</title>
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/2920/2920277.png" />
  </head>

<Navbar />
<title>{title}</title>
<style>
  .carousel {
    display: flex;
    overflow: hidden;
    scroll-behavior: smooth;
  }

  .carousel img {
    min-width: 100%;
    height: 20rem;
    object-fit: cover;
    flex-shrink: 0;
  }
</style>

<main class="bg-gray-950 text-gray-100 min-h-screen">
  <div class="max-w-6xl mx-auto px-6 py-32">

    <h1 class="text-4xl font-bold text-center text-blue-400 mb-16">
      {title}
    </h1>

    <div class="grid md:grid-cols-2 gap-10">

      <div
        class="carousel rounded-xl overflow-hidden"
        id="carousel"
      >
        {images.map((img) => (
          <img src={img.src} alt="Imagen del proyecto" />
        ))}

        <img src={images[0].src} alt="Imagen clonada" />
      </div>

      
      <div class="bg-gray-900 rounded-xl p-6 leading-relaxed text-gray-300 space-y-4 text-justify">
  {description
    .trim()
    .split("\n\n")
    .map((text) => (
      <p>{text}</p>
    ))}
</div>

    </div>

  </div>
</main>

<script>
  const carousel = document.getElementById("carousel");

  if (carousel) {
    const slides = carousel.children;
    let index = 0;

    setInterval(() => {
      index++;

      carousel.scrollTo({
        left: carousel.clientWidth * index,
        behavior: "smooth",
      });

      if (index === slides.length - 1) {
        setTimeout(() => {
          carousel.style.scrollBehavior = "auto";
          carousel.scrollLeft = 0;
          index = 0;
          carousel.style.scrollBehavior = "smooth";
        }, 600);
      }
    }, 4000);
  }
</script>
<Footer />